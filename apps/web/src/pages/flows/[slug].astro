---
import ServiceWorkerRegister from "../../ui/components/ServiceWorkerRegister.astro";
import "../../ui/styles/global.css";
import FlowRunner from "../../ui/islands/FlowRunner";
import { flows } from "../../registry/flows/generated/flows.generated";
import { routes } from "../../lib/routes";

export function getStaticPaths() {
  return flows.map((flow) => ({
    params: { slug: flow.slug },
    props: { flow }
  }));
}

const { flow } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="manifest" href={routes.manifest()} />
    <title>{flow.title} | Tinykite Tools</title>
    <meta name="description" content={flow.seo.description} />
  </head>
  <body>
    <main class="page">
      <a href={routes.home()}>Back</a>
      <h1>{flow.title}</h1>
      <p>{flow.seo.summary}</p>
      <FlowRunner client:visible flow={flow} />
    </main>
    <ServiceWorkerRegister />
  </body>
</html>
